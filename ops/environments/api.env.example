NODE_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=https://api.example.com
CLIENT_URL=https://app.example.com
MONGODB_URI_FILE=/run/secrets/mongodb_uri
MONGODB_AUTO_INDEX=false
MONGODB_MAX_POOL_SIZE=20
REDIS_URI_FILE=/run/secrets/redis_uri
JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_EXPIRATION=24h
JWT_ISSUER=express-graphql-mongodb-api
JWT_AUDIENCE=express-graphql-mongodb-client
BCRYPT_ROUNDS=12
MAIL_QUEUE_ENCRYPTION_KEY_FILE=/run/secrets/mail_queue_key
MAIL_DEFAULT_LANGUAGE=en
STORAGE_PATH=/app/storage/public
STORAGE_URL=/storage/public
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
# Configure exact trusted reverse-proxy addresses/CIDRs before serving through a proxy.
TRUST_PROXY=
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# GraphQL document limits; production introspection and GraphiQL are disabled.
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_FIELDS=100

# Account and recipient admission budgets (shared across API replicas).
ACCOUNT_RATE_LIMIT_MAX=30
MAIL_RECIPIENT_DAILY_MAX=20
MAIL_PURPOSE_DAILY_MAX=5
MAIL_RECIPIENT_COOLDOWN_MS=60000
# Quotas include each original plus a bounded 256 KiB conversion allowance.
MEDIA_OWNER_MAX_FILES=20
MEDIA_OWNER_MAX_BYTES=104857600
MEDIA_UNUSED_RETENTION_MS=86400000
MEDIA_UPLOAD_LEASE_MS=3600000
